---
/*
 * The wordmark, in place of Starlight's plain site title: monospace, tight, with the one
 * decorative use of the accent — the thread the product is named after.
 *
 * The name is split rather than written out twice so the two halves cannot drift apart, and the
 * link is one accessible name, not "weft" followed by a separate "db".
 */
const href = "/";
---

<a class="site-title" href={href}>weft<span class="thread">db</span></a>
