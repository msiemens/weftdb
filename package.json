{
  "name": "weftdb-workspace",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "imports": {
    "#root/*": "./*"
  },
  "scripts": {
    "bench": "node bench/run.ts",
    "test": "node --test tests/*.test.ts",
    "build": "node scripts/check-package-exports.mjs",
    "build:server": "vite build",
    "demo": "pnpm --filter weftdb-demo-todo dev",
    "demo:chat": "pnpm --filter weftdb-demo-chat dev",
    "demo:issues": "pnpm --filter weftdb-demo-issues dev",
    "demo:relay": "pnpm --filter weftdb-demo-shared relay",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spec": "tlc -config spec/WeftSync.cfg spec/WeftSync.tla",
    "spec:buggy": "tlc -config spec/WeftSyncBuggy.cfg spec/WeftSync.tla",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "weftdb": "workspace:*",
    "weftdb-cli": "workspace:*",
    "weftdb-demo-chat": "workspace:*",
    "weftdb-demo-issues": "workspace:*",
    "weftdb-demo-shared": "workspace:*",
    "weftdb-demo-todo": "workspace:*",
    "weftdb-react": "workspace:*"
  },
  "workspaces": [
    "packages/*",
    "demos/*"
  ]
}
